# Configure estas variáveis na hospedagem, ou inicie com node --env-file=.env server.mjs.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
BACKUP_INTERVAL_HOURS=24
# BACKUP_DIRECTORY=/caminho/privado/backups
# BACKUP_KEY_FILE=/caminho/privado/backup.key
# Em produção, configure uma senha forte na hospedagem, sem incluí-la no Git.
# ADMIN_PASSWORD=
# Alternativa: ADMIN_PASSWORD_HASH=<salt:hash scrypt gerado por admin-auth.mjs>
# DATABASE_PATH=/caminho/do/volume-persistente/reservas.sqlite
